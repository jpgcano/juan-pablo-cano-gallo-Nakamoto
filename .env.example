# Copia este archivo a .env y completa los valores. Ninguno de los que
# estan aqui es un secreto real.
#
# Advertencia sobre "#": si un valor contiene el caracter numeral, dotenv lo
# trata como inicio de comentario y trunca el resto AUNQUE no haya espacio
# antes (se detecto probando esto mismo, ver DECISIONS.md). Encierra en
# comillas cualquier valor que use "#", como se hace mas abajo.

# --- Base de datos ---
POSTGRES_DB=bd_juan_cano_nakamoto
POSTGRES_USER=riwi_owner
POSTGRES_PASSWORD=change_me_owner

# Conexion con la que corren las migraciones y el seed: usa el rol
# propietario (POSTGRES_USER), nunca rw_app.
DATABASE_URL=postgres://riwi_owner:change_me_owner@localhost:5432/bd_juan_cano_nakamoto

# Rol con el que se conecta el backend. Sin BYPASSRLS (ver ARCHITECTURE.md).
RW_APP_PASSWORD=change_me_app

# Rol del worker de embeddings (ver DECISIONS.md D9). Solo puede leer
# (id, body) de los mensajes y escribir en rw_message_embeddings.
RW_WORKER_PASSWORD=change_me_worker

# Contrasena de todos los usuarios del corpus semilla (database/seed/seed.json).
SEED_DEFAULT_PASSWORD="RiwiDev#2026"

# --- Backend ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Copiloto ---
# openai | fake  (fake no requiere red ni API key, respuestas deterministas)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api/v1
